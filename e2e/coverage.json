          ".toBe(\"timed_out\")",
          "data-run-state=\"completed\""
        ]
      },
      "rust": {
        "file": "run_tree_e2e.rs",
        "test": "renders_wait_transitions",
        "asserts": [
          "rendered(cx, \"wait:cohort:timed_out:1\")",
          "await_rendered(cx, \"row:run completed\", FRAME_ATTEMPTS)"
        ]
      },
      "rpcs": [
        "ultra.v1.AgentService/GetRun"
      ]
    },
    "agent_memory_inspection": {
      "web": {
        "file": "run-tree.spec.ts",
        "test": "inspects agent-written session memory",
        "asserts": [
          "data-testid=\"memory-entry\"][data-key=\"browser.note\"",
          "toContainText(\"written by an agent\")"
        ]
      },
      "rust": {
        "file": "run_tree_e2e.rs",
        "test": "inspects_memory_and_reconnects",
        "asserts": [
          "await_rendered(cx, \"memory:desktop.note\", FRAME_ATTEMPTS)",
          "await_rendered(cx, \"memory-count:1\", FRAME_ATTEMPTS)"
        ]
      },
