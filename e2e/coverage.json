    "replica_reconnect": {
      "web": {
        "file": "run-tree.spec.ts",
        "test": "reconnects through a second replica",
        "asserts": [
          "getByTestId(\"replica-switch\")",
          ".toBe(normalize(before))"
        ]
      },
      "rust": {
        "file": "run_tree_e2e.rs",
        "test": "inspects_memory_and_reconnects",
        "asserts": [
          "open_app_at(cx, &alt)",
          "the second replica rendered a different timeline"
        ]
      },
      "rpcs": [
        "ultra.v1.EventService/Subscribe"
      ]
    }
  },
  "deferred": {
    "ultra.v1.SessionService/Leave": {
      "owner": "A12.11",
      "reason": "Phase 8 proved leave and stale-presence expiry through the Go functional suite, but no first-party client exposes an explicit leave control yet; that ships with the complete client applications."
    },
    "ultra.v1.SessionService/GetMemory": {
      "owner": "A12.11",
      "reason": "Phase 8 proved single-key reads, caps, and namespace rules through the Go functional suite; the shipped clients list memory rather than reading one key, so client evidence waits for the complete applications."
    },
    "ultra.v1.SessionService/DeleteMemory": {
      "owner": "A12.11",
      "reason": "Phase 8 proved deletion and replay after deletion through the Go functional suite; no client offers a delete control yet."
    },
    "ultra.v1.AgentService/CancelRun": {
      "owner": "A9.8",
      "reason": "Phase 8 proved cancellation and its wait-abandonment races through the Go functional suite; the cancel control itself is part of Phase 9 application parity."
    },
    "ultra.v1.OrgService/CreateOrg": {
      "owner": "A12.11",
      "reason": "Org creation is an admin surface delivered with production auth in Phase 12."
    },
    "ultra.v1.OrgService/InviteMember": {
      "owner": "A12.11",
      "reason": "Membership management ships with the Phase 12 admin applications."
    },
    "ultra.v1.OrgService/ListMembers": {
      "owner": "A12.11",
      "reason": "Membership management ships with the Phase 12 admin applications."
    },
    "ultra.v1.FlowService/PutFlow": {
      "owner": "A9.8",
      "reason": "Flow authoring surfaces are Phase 9."
    },
    "ultra.v1.FlowService/GetFlow": {
      "owner": "A9.8",
      "reason": "Flow catalog and version selection are Phase 9."
    },
    "ultra.v1.FlowService/ListFlows": {
      "owner": "A9.8",
      "reason": "Flow catalog and version selection are Phase 9."
    },
    "ultra.v1.FlowService/InvokeFlow": {
      "owner": "A9.8",
      "reason": "Flow invocation and progress views are Phase 9."
    },
    "ultra.v1.AutomationService/PutPeriodicPrompt": {
      "owner": "A11.7",
      "reason": "Periodic schedules become user-facing once the real firing scheduler lands in Phase 11."
    },
    "ultra.v1.AutomationService/ListPeriodicPrompts": {
      "owner": "A11.7",
      "reason": "Periodic schedules become user-facing once the real firing scheduler lands in Phase 11."
    },
    "ultra.v1.AutomationService/SetPeriodicPromptEnabled": {
      "owner": "A11.7",
      "reason": "Enable/disable is proven with observed firings in Phase 11, not as a configuration record."
    }
  }
