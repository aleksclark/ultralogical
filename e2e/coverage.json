          "memory entry was never painted"
        ]
      }
    },
    "run_tree_linkage": {
      "web": {
        "file": "run-tree.spec.ts",
        "test": "renders a spawned run tree with child lanes",
        "asserts": [
          "toHaveAttribute(\"data-parent-run-id\", parentId!)",
          "getByTestId(\"cohort-marker\")"
        ]
      },
      "rust": {
        "file": "run_tree_e2e.rs",
        "test": "renders_run_tree_and_lanes",
        "asserts": [
          "await_rendered(cx, \"run-tree\", FRAME_ATTEMPTS)",
          "does not point at the parent"
        ]
      },
      "rpcs": [
        "ultra.v1.AgentService/GetRunTree"
      ]
    },
    "run_lane_filter": {
      "web": {
        "file": "run-tree.spec.ts",
